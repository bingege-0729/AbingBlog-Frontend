server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 文本资源压缩：JS/CSS/JSON/SVG 一般能压到原体积的三分之一左右
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml;

    # 健康检查：供 Docker HEALTHCHECK 与部署脚本 curl 使用
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # 构建产物文件名带内容哈希：内容一变文件名就变，因此可以放心强缓存一年
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # 自托管字体：文件名不带内容哈希，用 30 天缓存而不是一年，
    # 万一以后换字体文件不会被浏览器一直拿旧版
    location /fonts/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    # 入口 HTML 绝不能缓存：否则发版后浏览器还拿着旧 HTML，指向已删除的旧哈希 JS
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # SPA 前端：找不到的路径回退到 index.html（/posts/3 这类深链依赖这条规则）
    location / {
        try_files $uri $uri/ /index.html;
    }
}
